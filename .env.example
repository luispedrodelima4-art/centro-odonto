# ----------------------------------------------------
# APPLICATION ENVIRONMENT CONFIGURATION
# ----------------------------------------------------

# Node Environment
NODE_ENV=development

# Application Ports
BACKEND_PORT=3333
FRONTEND_PORT=3000

# PostgreSQL Database
DB_USER=postgres
DB_PASSWORD=postgres_secret_pass
DB_NAME=centro_odonto_db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secret_pass@localhost:5432/centro_odonto_db?schema=public

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO (S3 Compatible Object Storage)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword123
MINIO_ENDPOINT=localhost
MINIO_BUCKET_CLINICAL_RECORDS=clinical-records
MINIO_BUCKET_DIAGNOSTIC_IMAGES=diagnostic-images

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_centro_odonto_2026
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
